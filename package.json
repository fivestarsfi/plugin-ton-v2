{
  "name": "@elizaos/plugin-ton",
  "version": "1.4.2",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "@elizaos/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@elizaos/core": "latest",
    "@evaafi/sdk": "latest",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "15.1.0",
    "bignumber.js": "9.1.2",
    "node-cache": "5.1.2",
    "@dedust/sdk": "^0.8.7",
    "@pinata/sdk": "^2.1.0",
    "@ston-fi/api": "^0.19.0",
    "@ston-fi/sdk": "^2.2.2",
    "@torch-finance/core": "^1.3.2",
    "@torch-finance/dex-contract-wrapper": "^0.2.9",
    "@torch-finance/sdk": "^1.2.2",
    "@torch-finance/simulator": "^0.4.0",
    "@tonconnect/sdk": "^3.0.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "tsup": "8.3.5",
    "prettier": "^3.0.0",
    "bun": "^1.2.15",          
    "@types/bun": "latest",    
    "typescript": "^5.0.0"  
  },
  "scripts": {
  "build": "tsup",
  "dev": "tsup --watch",
  "lint": "prettier --write ./src",
  "clean": "rm -rf dist .turbo node_modules .turbo-tsconfig.json tsconfig.tsbuildinfo",
  "format": "prettier --write ./src",
  "format:check": "prettier --check ./src",
  "test": "bun test",                   
  "test:watch": "bun test --watch",     
  "test:coverage": "bun test --coverage" 
  },
  "peerDependencies": {
    "whatwg-url": "7.1.0"
  },
  "publishConfig": {
  "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:client:1.4.2",
    "pluginParameters": {
      "TON_PRIVATE_KEY": {
        "type": "string",
        "description": "Ton private key is required",
        "required": true,
        "sensitive": true
      },
      "TON_RPC_URL": {
        "type": "string",
        "description": "TON network RPC endpoint URL",
        "required": true,
        "sensitive": true
      }
    }
  }
}
