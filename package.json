{
    "name": "@elizaos/plugin-ton",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "@elizaos/source": "./src/index.ts",
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@dedust/sdk": "^0.8.7",
        "@elizaos/core": "latest",
        "@evaafi/sdk": "latest",
        "@pinata/sdk": "^2.1.0",
        "@ston-fi/api": "^0.19.0",
        "@ston-fi/sdk": "^2.2.2",
        "@ton/crypto": "3.3.0",
        "@ton/ton": "15.1.0",
        "@tonconnect/sdk": "^3.0.7",
        "@torch-finance/core": "^1.3.2",
        "@torch-finance/dex-contract-wrapper": "^0.2.9",
        "@torch-finance/sdk": "^1.2.2",
        "@torch-finance/simulator": "^0.4.0",
        "bignumber.js": "9.1.2",
        "node-cache": "5.1.2",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "bun": "^1.2.15",
        "glob": "^11.0.3",
        "prettier": "^3.0.0",
        "tsup": "8.3.5",
        "typescript": "^5.0.0"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "prettier --write ./src",
        "clean": "rm -rf dist .turbo node_modules .turbo-tsconfig.json tsconfig.tsbuildinfo",
        "format": "prettier --write ./src",
        "format:check": "prettier --check ./src",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "mnemonic": "tsup --format esm ./scripts/generate-ton-mnemonic.ts && node ./dist/generate-ton-mnemonic.js"
    },
    "peerDependencies": {
        "whatwg-url": "7.1.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "agentConfig": {
        "pluginType": "elizaos:plugin:1.0.0",
        "pluginParameters": {
            "TON_PRIVATE_KEY": {
                "type": "string",
                "description": "Ton private key is required",
                "required": true,
                "sensitive": true
            },
            "TON_RPC_URL": {
                "type": "string",
                "description": "TON network RPC endpoint URL",
                "required": false,
                "sensitive": false
            },
            "TON_RPC_API_KEY": {
                "type": "string",
                "description": "TON RPC API key for authenticated endpoints",
                "required": false,
                "sensitive": true
            }
        }
    }
}
